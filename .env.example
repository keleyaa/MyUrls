# HTTP 与公开短链接地址
MYURLS_PORT=8080
MYURLS_DOMAIN=example.com
MYURLS_PROTO=https

# Redis 连接与持久化
MYURLS_REDIS_CONN=myurls-redis:6379
# 密码属于秘密；生产部署请设置强随机值，不要提交真实值。
MYURLS_REDIS_PASSWORD=
MYURLS_REDIS_DATA_PATH=./data/redis

# 创建接口安全
# Token 属于秘密；非空时 POST /short 必须携带 Bearer Token。
MYURLS_API_TOKEN=
# 设为 0 可关闭限流。
MYURLS_RATE_LIMIT_RPS=5
MYURLS_RATE_LIMIT_BURST=10
MYURLS_MAX_BODY_BYTES=16384

# HTTP 超时（Go duration 格式）
MYURLS_READ_HEADER_TIMEOUT=5s
MYURLS_READ_TIMEOUT=10s
MYURLS_WRITE_TIMEOUT=10s
MYURLS_IDLE_TIMEOUT=60s
MYURLS_SHUTDOWN_TIMEOUT=10s
# 必须大于 MYURLS_SHUTDOWN_TIMEOUT，给应用留出完整优雅退出时间。
MYURLS_STOP_GRACE_PERIOD=20s

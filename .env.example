# Production runtime
NODE_ENV=production
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=https://myurl.example

# Redis is reachable only on the Compose network by default.
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_TIMEOUT_MS=750

# Use a unique random value with at least 32 bytes. Never use this example in production.
IP_HASH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
TRUST_PROXY_CIDRS=

# Cloudflare Turnstile. Production requires all four values below.
TURNSTILE_ENABLED=true
TURNSTILE_MODE=cloudflare
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_HOSTNAME=myurl.example
TURNSTILE_TIMEOUT_MS=2500

# Limits and lifecycle timeouts. Defaults are shown explicitly for review.
CREATE_DIRECT_LIMIT_10M=5
CREATE_HARD_LIMIT_10M=20
CREATE_HARD_LIMIT_1D=100
RESOLVE_LIMIT_10S=600
RISK_CHALLENGE_SCORE=3
RISK_BLOCK_SCORE=8
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000

MYURLS_PORT=8080
MYURLS_DOMAIN=example.com
MYURLS_PROTO=https
MYURLS_REDIS_CONN=myurls-redis:6379
MYURLS_REDIS_PASSWORD=
MYURLS_REDIS_DATA_PATH=./data/redis
MYURLS_API_TOKEN=
MYURLS_RATE_LIMIT_RPS=5
MYURLS_RATE_LIMIT_BURST=10
MYURLS_MAX_BODY_BYTES=16384
MYURLS_READ_HEADER_TIMEOUT=5s
MYURLS_READ_TIMEOUT=10s
MYURLS_WRITE_TIMEOUT=10s
